#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	// ++ ____ Тельнов А.А 01.10.2026
	// КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	// ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	Скидка = Объект.ДК_СогласованнаяСкидка + ТекущиеДанные.Скидка;
	Если Скидка > 100 Тогда
		ТекущиеДанные.Сумма = 0;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Суммарная скидка превышает 100%.");
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Сумма = (1 - Скидка / 100) * ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	// -- ____ Тельнов А.А 01.10.2026
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
// ++ ____ Тельнов А.А 01.10.2026
Процедура СогласованнаяСкидкаПриИзменении(Элемент)
	Если Объект.Товары.Количество() > 0 ИЛИ Объект.Услуги.Количество() > 0 Тогда
		ПроверкаНеобходимостиПересчетаТаблиц();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
// Обработчик команды 'ПересчитатьТаблицу' см. ПриСозданииНаСервере
Процедура ПересчитатьТаблицу(Команда)
	ПересчитатьТоварыИУслуги();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТоварыИУслуги()
	ПересчитатьСтрокиТаблицы(Объект.Товары);
	ПересчитатьСтрокиТаблицы(Объект.Услуги);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокиТаблицы(Таблица)
	Для Каждого Строка Из Таблица Цикл
		РассчитатьСуммуСтроки(Строка);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПроверкаНеобходимостиПересчетаТаблиц()
	Ответ = Ждать ВопросАсинх("Изменился процент скидки. Выполнить перерчсчет таблиц Товаров и Услуг?", РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПересчитатьТоварыИУслуги();
	КонецЕсли;
КонецПроцедуры
// -- ____ Тельнов А.А 01.10.2026

